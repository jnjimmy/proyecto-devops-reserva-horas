# ---------------------------------------------------------
# Archivo de EJEMPLO de variables de entorno.
# Copiar como .env para uso local:  copy .env.example .env
# El archivo .env real NO se versiona (está en .gitignore).
# NUNCA escribir aquí contraseñas, tokens ni datos reales.
# ---------------------------------------------------------

# Puerto local donde se publica el servicio
APP_PORT=8080

# Entorno de ejecución (local | pruebas)
APP_ENV=local

# Versión del servicio
APP_VERSION=1.0.0

# Ejemplo de variable sensible: solo marcador, sin valor real
# API_KEY=reemplazar_en_archivo_env_local
